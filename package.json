{
  "name": "omeka-s-themes",
  "version": "0.1.0",
  "private": true,
  "description": "Static catalog of Omeka S themes, built daily into docs/ and served by GitHub Pages at https://omeka.ldas.jp",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node --env-file-if-exists=.env scripts/build.mjs",
    "test": "node --test tests/*.test.mjs && node scripts/check-site.mjs",
    "test:site": "node scripts/check-site.mjs",
    "test:live": "node scripts/check-live.mjs"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2"
  }
}
